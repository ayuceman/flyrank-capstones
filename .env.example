# copy to .env   ->   cp .env.example .env

# postgres (matches docker-compose.yml)
DATABASE_URL=postgres://metering:metering@localhost:5432/metering
POSTGRES_USER=metering
POSTGRES_PASSWORD=metering
POSTGRES_DB=metering

# app
PORT=3000
ADMIN_KEY=change-me-admin-key          # X-Admin-Key for POST /tenants
JOBS_ENABLED=true                      # run the background worker in this process
ALERT_WEBHOOK_URL=                     # optional: POST usage alerts here (e.g. a webhook.site url)

# stripe - TEST MODE ONLY. never a live key.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx        # from `stripe listen --forward-to localhost:3000/webhooks/stripe`
STRIPE_PRO_PRICE_ID=price_xxx          # a recurring $29/month price created in the Stripe test dashboard
APP_BASE_URL=http://localhost:3000     # where Checkout sends the customer back
